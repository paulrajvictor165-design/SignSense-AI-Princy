# SignSense AI – Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ─── Google Gemini API (Required) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenRouteService (Required) ────────────────────────────────────────────
ORS_API_KEY=your_openrouteservice_api_key_here

# ─── Roboflow (Optional) ────────────────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ─── App Settings ────────────────────────────────────────────────────────────
DEBUG=true
PORT=5000

# Change this to a long random string before deploying to production.
SECRET_KEY=signsense-ai-secret-key-change-in-production

# ─── Security — Upload Limits ────────────────────────────────────────────────
# Maximum image upload size in bytes. Default: 33554432 (32 MB).
MAX_UPLOAD_BYTES=33554432

# Maximum allowed pixel dimension (width or height) for uploaded images.
MAX_IMAGE_DIMENSION=4096

# ─── Security — CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development only.
# Example: https://myapp.example.com,https://staging.example.com
CORS_ORIGINS=*

# ─── Model Paths ─────────────────────────────────────────────────────────────
# Path to the YOLOv8 model weights file.
# Use yolov8n.torchscript for ~1.4x faster CPU inference.
YOLO_MODEL_PATH=yolov8n.pt

# Path to the custom currency detection model (leave blank to use Gemini fallback).
CURRENCY_MODEL_PATH=
